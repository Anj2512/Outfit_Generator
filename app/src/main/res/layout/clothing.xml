<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CDF0F4"
    android:backgroundTint="#D9F1F4">

    <ImageView
        android:id="@+id/imageShirt"
        android:layout_width="98dp"
        android:layout_height="107dp"
        android:layout_marginTop="68dp"
        android:layout_marginEnd="174dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/imageBot"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/avatars" />

    <ImageView
        android:id="@+id/imageBot"
        android:layout_width="100dp"
        android:layout_height="105dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/imageShoe"
        app:layout_constraintStart_toEndOf="@+id/swapBot"
        app:layout_constraintTop_toBottomOf="@+id/imageShirt"
        tools:srcCompat="@tools:sample/avatars" />

    <ImageView
        android:id="@+id/imageAccess"
        android:layout_width="94dp"
        android:layout_height="86dp"
        android:layout_marginTop="29dp"
        android:layout_marginEnd="174dp"
        android:layout_marginBottom="65dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageShoe"
        tools:srcCompat="@tools:sample/avatars" />

    <ImageView
        android:id="@+id/imageShoe"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="54dp"
        android:layout_marginBottom="42dp"
        app:layout_constraintBottom_toTopOf="@+id/imageAccess"
        app:layout_constraintEnd_toStartOf="@+id/swapJack"
        app:layout_constraintTop_toBottomOf="@+id/imageBot"
        tools:srcCompat="@tools:sample/avatars" />

    <ImageView
        android:id="@+id/imageJack"
        android:layout_width="102dp"
        android:layout_height="88dp"
        android:layout_marginTop="132dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/avatars" />

    <ImageView
        android:id="@+id/imageBag"
        android:layout_width="97dp"
        android:layout_height="112dp"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/swapJack"
        tools:srcCompat="@tools:sample/avatars" />

    <Button
        android:id="@+id/swapShirt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="106dp"
        android:layout_marginBottom="104dp"
        android:backgroundTint="#00BCD4"
        android:text="Swap"
        app:layout_constraintBottom_toTopOf="@+id/swapBot"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/swapBot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="104dp"
        android:backgroundTint="#00BCD4"
        android:text="Swap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/swapShirt" />

    <Button
        android:id="@+id/swapShoe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="101dp"
        android:backgroundTint="#00BCD4"
        android:text="Swap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/swapBot" />

    <Button
        android:id="@+id/swapAccess"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="131dp"
        android:layout_marginBottom="97dp"
        android:backgroundTint="#00BCD4"
        android:text="Swap"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/swapShoe" />

    <Button
        android:id="@+id/swapJack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="30dp"
        android:backgroundTint="#00BCD4"
        android:text="Swap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageJack" />

    <Button
        android:id="@+id/swapBag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="222dp"
        android:backgroundTint="#00BCD4"
        android:text="Swap"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageBag" />

    <Switch
        android:id="@+id/switch1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="79dp"
        android:text="Favorite "
        android:textColor="#009688"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageAccess" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="97dp"
        android:layout_marginTop="77dp"
        android:layout_marginEnd="45dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageAccess"
        app:layout_constraintTop_toBottomOf="@+id/swapBag"
        app:srcCompat="@android:drawable/btn_star_big_off" />

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="97dp"
        android:layout_marginTop="77dp"
        android:layout_marginEnd="45dp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageAccess"
        app:layout_constraintTop_toBottomOf="@+id/swapBag"
        app:srcCompat="@android:drawable/btn_star_big_on" />

</androidx.constraintlayout.widget.ConstraintLayout>